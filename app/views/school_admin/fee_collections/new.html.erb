<div class="page-header">
  <h1>Collect Fee</h1>
</div>

<%= form_with model: [:school_admin, @fee_collection], class: "form-grid" do |f| %>
  <% if @fee_collection.errors.any? %>
    <div class="flash flash-alert">
      <ul>
        <% @fee_collection.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :student_id, "Student" %>
    <%= f.collection_select :student_id, @students, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :fee_structure_id, "Fee Structure" %>
    <%= f.collection_select :fee_structure_id, @fee_structures, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :amount %>
    <%= f.number_field :amount, step: 0.01, min: 0, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :paid_date %>
    <%= f.date_field :paid_date, value: Date.today %>
  </div>

  <div class="form-group">
    <%= f.label :due_date %>
    <%= f.date_field :due_date %>
  </div>

  <div class="form-group">
    <%= f.label :payment_mode %>
    <%= f.select :payment_mode, payment_mode_options, include_blank: "Select Mode" %>
  </div>

  <div class="form-group">
    <%= f.label :status %>
    <%= f.select :status, [["Paid", "paid"], ["Partial", "partial"], ["Unpaid", "unpaid"]] %>
  </div>

  <div class="form-group">
    <%= f.submit "Collect Fee", class: "btn btn-primary" %>
    <%= link_to "Cancel", school_admin_fee_collections_path, class: "btn btn-secondary" %>
  </div>
<% end %>
