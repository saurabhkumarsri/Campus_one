<div class="page-header">
  <h1>Fee Receipt</h1>
  <%= link_to "Download PDF", receipt_school_admin_fee_collection_path(@fee_collection, format: :pdf), class: "btn btn-primary" %>
</div>

<div class="receipt-box">
  <div class="receipt-header">
    <h2>FEE RECEIPT</h2>
    <p><%= @fee_collection.student.school.name %></p>
  </div>

  <div class="receipt-row">
    <span>Receipt No</span>
    <span><strong><%= @fee_collection.receipt_no %></strong></span>
  </div>

  <div class="receipt-row">
    <span>Date</span>
    <span><%= @fee_collection.paid_date&.strftime("%d %b %Y") || "N/A" %></span>
  </div>

  <div class="receipt-row">
    <span>Student</span>
    <span><%= @fee_collection.student.name %></span>
  </div>

  <div class="receipt-row">
    <span>Class</span>
    <span><%= @fee_collection.student.classroom&.name || "N/A" %></span>
  </div>

  <div class="receipt-row">
    <span>Fee Type</span>
    <span><%= @fee_collection.fee_structure.name %></span>
  </div>

  <div class="receipt-row">
    <span>Payment Mode</span>
    <span><%= @fee_collection.payment_mode.to_s.humanize %></span>
  </div>

  <div class="receipt-row">
    <span>Status</span>
    <span><%= badge_for(@fee_collection.status) %></span>
  </div>

  <div class="receipt-row total">
    <span>Amount Paid</span>
    <span><%= number_to_currency(@fee_collection.amount, unit: "₹") %></span>
  </div>

  <p style="text-align: center; margin-top: 20px; font-size: 12px; color: var(--text-muted);">
    This is a computer generated receipt and does not require signature.
  </p>
</div>
