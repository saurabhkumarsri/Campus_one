<div class="page-header">
  <h1>⏰ Timetable</h1>
  <% if current_user.school_admin? %>
    <%= link_to "Add Entry", new_school_admin_timetable_path, class: "btn btn-primary" %>
  <% end %>
</div>

<% days = %w[monday tuesday wednesday thursday friday saturday sunday] %>
<% days.each do |day| %>
  <% day_entries = @timetables.select { |t| t.day_of_week == day } %>
  <div class="card" style="margin-bottom: 12px;">
    <h3><%= day.to_s.humanize %></h3>
    <% if day_entries.any? %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Period</th>
            <th>Time</th>
            <th>Class</th>
            <th>Subject</th>
            <% if current_user.school_admin? %><th>Teacher</th><th>Actions</th><% end %>
          </tr>
        </thead>
        <tbody>
          <% day_entries.sort_by(&:period).each do |t| %>
            <tr>
              <td><%= t.period %></td>
              <td><%= t.start_time.strftime("%I:%M %p") rescue "N/A" %> - <%= t.end_time.strftime("%I:%M %p") rescue "N/A" %></td>
              <td><%= t.classroom&.name %></td>
              <td><%= t.subject&.name %></td>
              <% if current_user.school_admin? %>
                <td><%= t.teacher&.name %></td>
                <td>
                  <%= link_to "Edit", edit_school_admin_timetable_path(t), class: "btn btn-sm btn-secondary" %>
                  <%= link_to "Delete", school_admin_timetable_path(t), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state">No classes scheduled.</p>
    <% end %>
  </div>
<% end %>
