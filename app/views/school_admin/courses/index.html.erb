<div class="page-header">
  <h1>Courses</h1>
  <%= link_to "New Course", new_school_admin_course_path, class: "btn btn-primary" %>
</div>

<div class="cards-grid">
  <% @courses.each do |course| %>
    <div class="card">
      <div class="card-header">
        <h3><%= course.title %></h3>
        <span class="badge badge-<%= course.status %>"><%= course.status %></span>
      </div>
      <div class="card-body">
        <p><strong>Class:</strong> <%= course.classroom.name %></p>
        <p><strong>Subject:</strong> <%= course.subject.name %></p>
        <p><strong>Teacher:</strong> <%= course.teacher.full_name %></p>
      </div>
      <div class="card-footer">
        <%= link_to "View", school_admin_course_path(course), class: "btn btn-sm" %>
        <%= link_to "Edit", edit_school_admin_course_path(course), class: "btn btn-sm" %>
        <%= link_to "Delete", school_admin_course_path(course), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
      </div>
    </div>
  <% end %>
</div>
