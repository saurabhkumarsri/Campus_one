<div class="page-header">
  <h1><%= @course.title %></h1>
  <span class="badge badge-<%= @course.status %>"><%= @course.status %></span>
  <%= link_to "Edit", edit_school_admin_course_path(@course), class: "btn" %>
  <%= link_to "Back", school_admin_courses_path, class: "btn" %>
</div>

<div class="course-details">
  <p><strong>Description:</strong> <%= @course.description %></p>
  <p><strong>Classroom:</strong> <%= @course.classroom.name %></p>
  <p><strong>Subject:</strong> <%= @course.subject.name %></p>
  <p><strong>Teacher:</strong> <%= @course.teacher.full_name %></p>
</div>

<hr>

<h2>Chapters</h2>
<div class="chapters-list">
  <% @course.chapters.each do |chapter| %>
    <div class="card">
      <div class="card-header">
        <h3><%= chapter.title %></h3>
        <button type="button" class="btn btn-sm toggle-chapter">Expand</button>
      </div>
      <div class="card-body chapter-content" style="display: none;">
        <p><%= chapter.description %></p>

        <h4>Topics</h4>
        <ul>
          <% chapter.topics.each do |topic| %>
            <li><%= topic.title %></li>
          <% end %>
        </ul>

        <h4>Quizzes</h4>
        <ul>
          <% chapter.quizzes.each do |quiz| %>
            <li><%= quiz.title %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>

<hr>

<h2>Add Chapter</h2>
<%= form_with model: [:school_admin, @course, Chapter.new], class: "form" do |f| %>
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_area :description, rows: 3, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= f.submit "Add Chapter", class: "btn btn-primary" %>
  </div>
<% end %>

<hr>

<h2>Add Topic</h2>
<%= form_with model: [:school_admin, @course, Topic.new], class: "form" do |f| %>
  <div class="form-group">
    <%= f.label :chapter_id, "Chapter" %>
    <%= f.collection_select :chapter_id, @course.chapters, :id, :title, {}, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= f.label :content %>
    <%= f.text_area :content, rows: 4, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= f.submit "Add Topic", class: "btn btn-primary" %>
  </div>
<% end %>

<hr>

<h2>Add Quiz</h2>
<%= form_with model: [:school_admin, @course, Quiz.new], class: "form" do |f| %>
  <div class="form-group">
    <%= f.label :chapter_id, "Chapter" %>
    <%= f.collection_select :chapter_id, @course.chapters, :id, :title, {}, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= f.label :duration, "Duration (minutes)" %>
    <%= f.number_field :duration, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= f.submit "Add Quiz", class: "btn btn-primary" %>
  </div>
<% end %>

<hr>

<h2>Enrollments</h2>
<table class="data-table">
  <thead>
    <tr>
      <th>Student</th>
      <th>Roll Number</th>
      <th>Status</th>
      <th>Enrolled At</th>
    </tr>
  </thead>
  <tbody>
    <% @course.enrollments.each do |enrollment| %>
      <tr>
        <td><%= enrollment.student.full_name %></td>
        <td><%= enrollment.student.roll_number %></td>
        <td>
          <span class="badge badge-<%= enrollment.status %>"><%= enrollment.status %></span>
        </td>
        <td><%= l(enrollment.created_at, format: :short) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
