<div class="page-header">
  <h1>Teacher Monthly Report</h1>
</div>

<%= form_with url: monthly_report_school_admin_teacher_attendances_path, method: :get, class: "filter-bar" do |f| %>
  <div class="form-group">
    <%= f.label :month, "Month" %>
    <%= f.select :month, (1..12).map { |m| [Date::MONTHNAMES[m], m] }, selected: @month %>
  </div>
  <div class="form-group">
    <%= f.label :year, "Year" %>
    <%= f.select :year, ((Date.today.year - 2)..(Date.today.year + 1)).to_a.reverse, selected: @year %>
  </div>
  <div class="form-group">
    <%= f.submit "Generate", class: "btn btn-secondary" %>
  </div>
<% end %>

<% if @teachers.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Teacher</th>
        <th>Present</th>
        <th>Absent</th>
        <th>Leave</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% @teachers.each do |teacher| %>
        <% present = @attendances[[teacher.id, "present"]] || 0 %>
        <% absent = @attendances[[teacher.id, "absent"]] || 0 %>
        <% leave = @attendances[[teacher.id, "leave"]] || 0 %>
        <% total = present + absent + leave %>
        <tr>
          <td><%= teacher.name %></td>
          <td><span class="badge badge-success"><%= present %></span></td>
          <td><span class="badge badge-danger"><%= absent %></span></td>
          <td><span class="badge badge-warning"><%= leave %></span></td>
          <td><strong><%= total %></strong></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">📊</div>
    <h3>No Teachers</h3>
    <p>Add teachers first to view reports.</p>
  </div>
<% end %>
