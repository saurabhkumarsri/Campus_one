<div class="page-header">
  <h1>Drivers</h1>
  <%= link_to "Add Driver", new_school_admin_driver_path, class: "btn btn-primary" %>
</div>

<div class="data-table">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>License Number</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @drivers.each do |driver| %>
        <tr>
          <td><%= driver.name %></td>
          <td><%= driver.phone %></td>
          <td><%= driver.license_number %></td>
          <td><span class="badge"><%= driver.status %></span></td>
          <td>
            <%= link_to "Edit", edit_school_admin_driver_path(driver), class: "btn" %>
            <%= link_to "Delete", school_admin_driver_path(driver), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
