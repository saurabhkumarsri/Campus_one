<div class="page-header">
  <h1>Add Driver</h1>
  <%= link_to "Back", school_admin_drivers_path, class: "btn" %>
</div>

<%= form_with model: [:school_admin, @driver], class: "form-grid" do |f| %>
  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="form-group">
    <%= f.label :phone %>
    <%= f.telephone_field :phone %>
  </div>

  <div class="form-group">
    <%= f.label :license_number %>
    <%= f.text_field :license_number %>
  </div>

  <div class="form-group">
    <%= f.label :license_expiry %>
    <%= f.date_field :license_expiry %>
  </div>

  <div class="form-group">
    <%= f.label :status %>
    <%= f.select :status, ["Active", "Inactive", "On Leave"] %>
  </div>

  <div class="form-group">
    <%= f.label :address %>
    <%= f.text_area :address, rows: 3 %>
  </div>

  <div class="form-group">
    <%= f.submit "Create Driver", class: "btn btn-primary" %>
  </div>
<% end %>
