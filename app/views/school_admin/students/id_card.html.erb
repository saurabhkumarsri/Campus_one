<div class="page-header">
  <h1>ID Card: <%= @student.name %></h1>
  <%= link_to "Download PDF", download_id_card_school_admin_student_path(@student), class: "btn btn-primary" %>
</div>

<div class="id-card-preview">
  <div class="id-card-header">
    <h3>CAMPUS ONE</h3>
    <p>Student ID Card</p>
  </div>

  <div class="id-card-photo">
    👤
  </div>

  <div class="id-card-info">
    <p><strong>Name:</strong> <%= @student.name %></p>
    <p><strong>Roll No:</strong> <%= @student.roll_no || "N/A" %></p>
    <p><strong>Class:</strong> <%= @student.classroom&.name || "N/A" %></p>
    <p><strong>Section:</strong> <%= @student.section&.name || "N/A" %></p>
    <p><strong>Father:</strong> <%= @student.father_name || "N/A" %></p>
    <p><strong>Mobile:</strong> <%= @student.mobile || "N/A" %></p>
  </div>
</div>
