<div class="page-header">
  <h1>Students</h1>
  <%= link_to "+ New Student", new_school_admin_student_path, class: "btn btn-primary" %>
</div>

<% if @students.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Roll No</th>
        <th>Class</th>
        <th>Section</th>
        <th>Father</th>
        <th>Mobile</th>
        <th>Status</th>
        <th class="actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @students.each do |student| %>
        <tr>
          <td><%= link_to student.name, school_admin_student_path(student) %></td>
          <td><%= student.roll_no || "—" %></td>
          <td><%= student.classroom&.name || "—" %></td>
          <td><%= student.section&.name || "—" %></td>
          <td><%= student.father_name || "—" %></td>
          <td><%= student.mobile || "—" %></td>
          <td><%= badge_for(student.status) %></td>
          <td class="actions">
            <%= link_to "Edit", edit_school_admin_student_path(student), class: "btn btn-sm btn-secondary" %>
            <%= link_to "ID Card", id_card_school_admin_student_path(student), class: "btn btn-sm btn-secondary" %>
            <%= button_to "Delete", school_admin_student_path(student), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">👨‍🎓</div>
    <h3>No Students</h3>
    <p>Add students to your school.</p>
    <%= link_to "Create Student", new_school_admin_student_path, class: "btn btn-primary" %>
  </div>
<% end %>
