<div class="page-header">
  <h1>Homeworks</h1>
  <%= link_to "+ New Homework", new_school_admin_homework_path, class: "btn btn-primary" %>
</div>

<%= form_with url: school_admin_homeworks_path, method: :get, class: "filter-bar" do |f| %>
  <div class="form-group">
    <%= f.label :classroom_id, "Class" %>
    <%= f.collection_select :classroom_id, @classrooms || [], :id, :name, include_blank: "All Classes", selected: params[:classroom_id] %>
  </div>
  <div class="form-group">
    <%= f.label :teacher_id, "Teacher" %>
    <%= f.collection_select :teacher_id, @teachers || [], :id, :name, include_blank: "All Teachers", selected: params[:teacher_id] %>
  </div>
  <div class="form-group">
    <%= f.submit "Filter", class: "btn btn-secondary" %>
    <%= link_to "Clear", school_admin_homeworks_path, class: "btn btn-secondary" %>
  </div>
<% end %>

<% if @homeworks.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Class</th>
        <th>Subject</th>
        <th>Teacher</th>
        <th>Due Date</th>
        <th>Status</th>
        <th class="actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @homeworks.each do |homework| %>
        <tr>
          <td><%= homework.title %></td>
          <td><%= homework.classroom.name %><%= homework.section ? " - #{homework.section.name}" : "" %></td>
          <td><%= homework.subject.name %></td>
          <td><%= homework.teacher.name %></td>
          <td><%= homework.due_date&.strftime("%d %b %Y") || "—" %></td>
          <td><%= badge_for(homework.status) %></td>
          <td class="actions">
            <%= link_to "View", school_admin_homework_path(homework), class: "btn btn-sm btn-secondary" %>
            <%= link_to "Edit", edit_school_admin_homework_path(homework), class: "btn btn-sm btn-secondary" %>
            <%= button_to "Delete", school_admin_homework_path(homework), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">📚</div>
    <h3>No Homeworks</h3>
    <p>Assign homework to your students.</p>
    <%= link_to "Create Homework", new_school_admin_homework_path, class: "btn btn-primary" %>
  </div>
<% end %>
