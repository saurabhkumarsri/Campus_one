<%= form_with model: [:school_admin, @homework], class: "form-grid", multipart: true do |f| %>
  <% if @homework.errors.any? %>
    <div class="flash flash-alert">
      <ul>
        <% @homework.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :teacher_id, "Teacher" %>
    <%= f.collection_select :teacher_id, @teachers, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :classroom_id, "Class" %>
    <%= f.collection_select :classroom_id, @classrooms, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :section_id, "Section (optional)" %>
    <%= f.collection_select :section_id, @sections, :id, :name, include_blank: "All Sections" %>
  </div>

  <div class="form-group">
    <%= f.label :subject_id, "Subject" %>
    <%= f.collection_select :subject_id, @subjects, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_area :description, rows: 5 %>
  </div>

  <div class="form-group">
    <%= f.label :due_date %>
    <%= f.date_field :due_date, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :attachments, "File Attachments" %>
    <%= f.file_field :attachments, multiple: true %>
    <% if @homework.attachments.attached? %>
      <ul>
        <% @homework.attachments.each do |attachment| %>
          <li><%= attachment.filename %></li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", school_admin_homeworks_path, class: "btn btn-secondary" %>
  </div>
<% end %>
