<div class="page-header">
  <h1>Room <%= @hostel_room.room_number %></h1>
  <%= link_to "Edit", edit_school_admin_hostel_room_path(@hostel_room), class: "btn" %>
  <%= link_to "Back", school_admin_hostel_rooms_path, class: "btn" %>
</div>

<div class="cards-grid">
  <div class="card">
    <h3>Room Details</h3>
    <p><strong>Floor:</strong> <%= @hostel_room.floor %></p>
    <p><strong>Type:</strong> <%= @hostel_room.room_type %></p>
    <p><strong>Capacity:</strong> <%= @hostel_room.capacity %></p>
    <p><strong>Occupied:</strong> <%= @hostel_room.occupied %></p>
    <p><strong>Vacant:</strong> <%= @hostel_room.vacant %></p>
    <p><span class="badge"><%= @hostel_room.vacant > 0 ? "Available" : "Full" %></span></p>
  </div>
</div>

<h2>Beds</h2>

<div class="data-table">
  <table>
    <thead>
      <tr>
        <th>Bed Number</th>
        <th>Occupant</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @hostel_room.beds.each do |bed| %>
        <tr>
          <td><%= bed.bed_number %></td>
          <td><%= bed.occupant_name || "—" %></td>
          <td><span class="badge"><%= bed.status %></span></td>
          <td>
            <% if bed.vacant? %>
              <%= link_to "Allocate", new_school_admin_hostel_allocation_path(bed_id: bed.id), class: "btn btn-primary" %>
            <% else %>
              <%= link_to "Vacate", school_admin_hostel_allocation_path(bed.allocation), data: { turbo_method: :patch, turbo_confirm: "Vacate this bed?" }, class: "btn" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
