<div class="page-header">
  <h1><%= @exam.title %></h1>
  <div>
    <%= link_to "Results", results_school_admin_exam_path(@exam), class: "btn btn-secondary" %>
    <%= link_to "Edit", edit_school_admin_exam_path(@exam), class: "btn btn-secondary" %>
    <%= link_to "Back", school_admin_exams_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card">
  <div class="form-grid">
    <div>
      <p><strong>Class:</strong> <%= @exam.classroom.name %><%= @exam.section ? " - #{@exam.section.name}" : "" %></p>
      <p><strong>Subject:</strong> <%= @exam.subject.name %></p>
      <p><strong>Date:</strong> <%= @exam.exam_date&.strftime("%d %b %Y") || "—" %></p>
      <p><strong>Time:</strong> <%= @exam.start_time&.strftime("%I:%M %p") || "—" %> to <%= @exam.end_time&.strftime("%I:%M %p") || "—" %></p>
    </div>
    <div>
      <p><strong>Type:</strong> <%= @exam.exam_type.humanize %></p>
      <p><strong>Max Marks:</strong> <%= @exam.max_marks %></p>
      <p><strong>Pass Marks:</strong> <%= @exam.pass_marks %></p>
      <p><strong>Status:</strong> <%= badge_for(@exam.status) %></p>
    </div>
  </div>
  <% if @exam.instructions.present? %>
    <div style="margin-top: 12px;">
      <p><strong>Instructions:</strong></p>
      <p><%= @exam.instructions %></p>
    </div>
  <% end %>
</div>

<h2 style="margin-top: 24px;">Results</h2>

<% if @results.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Student</th>
        <th>Marks Obtained</th>
        <th>Grade</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @results.each do |result| %>
        <tr>
          <td><%= result.student.name %></td>
          <td><%= result.marks_obtained || "—" %></td>
          <td><%= result.grade || "—" %></td>
          <td><%= badge_for(result.status) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">📊</div>
    <h3>No Results</h3>
    <p>Add results for this exam from the Results page.</p>
    <%= link_to "Enter Results", results_school_admin_exam_path(@exam), class: "btn btn-primary" %>
  </div>
<% end %>
