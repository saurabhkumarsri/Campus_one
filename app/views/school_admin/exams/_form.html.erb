<%= form_with model: [:school_admin, @exam], class: "form-grid" do |f| %>
  <% if @exam.errors.any? %>
    <div class="flash flash-alert">
      <ul>
        <% @exam.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :classroom_id, "Class" %>
    <%= f.collection_select :classroom_id, @classrooms, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :section_id, "Section (optional)" %>
    <%= f.collection_select :section_id, @sections, :id, :name, include_blank: "All Sections" %>
  </div>

  <div class="form-group">
    <%= f.label :subject_id, "Subject" %>
    <%= f.collection_select :subject_id, @subjects, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :exam_type, "Exam Type" %>
    <%= f.select :exam_type, [["Mid Term", "mid_term"], ["Final", "final"], ["Weekly Test", "weekly_test"], ["Unit Test", "unit_test"], ["Quiz", "quiz"]], include_blank: "Select Type", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :exam_date %>
    <%= f.date_field :exam_date, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :start_time %>
    <%= f.time_field :start_time %>
  </div>

  <div class="form-group">
    <%= f.label :end_time %>
    <%= f.time_field :end_time %>
  </div>

  <div class="form-group">
    <%= f.label :max_marks %>
    <%= f.number_field :max_marks, step: 0.01, min: 0, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :pass_marks %>
    <%= f.number_field :pass_marks, step: 0.01, min: 0, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :instructions %>
    <%= f.text_area :instructions, rows: 4 %>
  </div>

  <div class="form-group">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", school_admin_exams_path, class: "btn btn-secondary" %>
  </div>
<% end %>
