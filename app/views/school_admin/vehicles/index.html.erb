<div class="page-header">
  <h1>Vehicles</h1>
  <%= link_to "Add Vehicle", new_school_admin_vehicle_path, class: "btn btn-primary" %>
</div>

<div class="data-table">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Registration No</th>
        <th>Type</th>
        <th>Capacity</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @vehicles.each do |vehicle| %>
        <tr>
          <td><%= vehicle.name %></td>
          <td><%= vehicle.reg_no %></td>
          <td><%= vehicle.vehicle_type %></td>
          <td><%= vehicle.capacity %></td>
          <td><span class="badge"><%= vehicle.status %></span></td>
          <td>
            <%= link_to "Edit", edit_school_admin_vehicle_path(vehicle), class: "btn" %>
            <%= link_to "Delete", school_admin_vehicle_path(vehicle), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
