<div class="page-header">
  <h1><%= @assignment.title %></h1>
  <span class="badge badge-info"><%= @assignment.status.humanize %></span>
</div>

<div class="card">
  <p><strong>Class:</strong> <%= @assignment.classroom&.name %></p>
  <p><strong>Subject:</strong> <%= @assignment.subject&.name %></p>
  <p><strong>Due Date:</strong> <%= @assignment.due_date.strftime("%d %b %Y") %></p>
  <p><strong>Max Marks:</strong> <%= @assignment.max_marks %></p>
  <% if @assignment.description.present? %>
    <p><strong>Description:</strong></p>
    <p><%= simple_format(@assignment.description) %></p>
  <% end %>
</div>

<div style="display: flex; gap: 8px; flex-wrap: wrap;">
  <%= link_to "Submissions", submissions_school_admin_assignment_path(@assignment), class: "btn btn-primary" %>
  <%= link_to "Edit", edit_school_admin_assignment_path(@assignment), class: "btn btn-secondary" %>
  <%= link_to "Back", school_admin_assignments_path, class: "btn btn-secondary" %>
</div>
