<div class="page-header">
  <h1>Edit Question</h1>
</div>

<%= form_with model: [:school_admin, @question], class: "form" do |f| %>
  <div class="form-group">
    <%= f.label :teacher_id, "Teacher" %>
    <%= f.collection_select :teacher_id, Teacher.where(school_id: current_user.school_id), :id, :name, {}, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :subject_id, "Subject" %>
    <%= f.collection_select :subject_id, Subject.where(school_id: current_user.school_id), :id, :name, {}, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :difficulty %>
    <%= f.select :difficulty, QuestionBank.difficulties.keys.map { |d| [d.humanize, d] } %>
  </div>
  <div class="form-group">
    <%= f.label :question_text, "Question" %>
    <%= f.text_area :question_text, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :marks %>
    <%= f.number_field :marks, min: 1, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :answer_key, "Answer / Key" %>
    <%= f.text_area :answer_key %>
  </div>
  <%= f.submit "Update", class: "btn btn-primary" %>
<% end %>
