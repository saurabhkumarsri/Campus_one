<div class="page-header">
  <h1>👨‍🎓 My Students</h1>
</div>

<% if @students.any? %>
  <div class="card">
    <table class="data-table">
      <thead>
        <tr>
          <th>Roll No</th>
          <th>Name</th>
          <th>Class</th>
          <th>Section</th>
          <th>Attendance %</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @students.each do |student| %>
          <% total = student.student_attendances.count %>
          <% present = student.student_attendances.where(status: "present").count %>
          <% pct = total > 0 ? (present.to_f / total * 100).round(1) : 0 %>
          <tr>
            <td><%= student.roll_no || "N/A" %></td>
            <td><%= student.name %></td>
            <td><%= student.classroom&.name || "N/A" %></td>
            <td><%= student.section&.name || "N/A" %></td>
            <td><%= pct %>%</td>
            <td>
              <%= link_to "Profile", school_admin_student_path(student), class: "btn btn-sm btn-secondary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty-state">No students found.</p>
<% end %>
