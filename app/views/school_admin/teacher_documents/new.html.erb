<div class="page-header">
  <h1>Upload Document</h1>
</div>

<%= form_with model: [:school_admin, @document], class: "form" do |f| %>
  <div class="form-group">
    <%= f.label :teacher_id, "Teacher" %>
    <%= f.collection_select :teacher_id, Teacher.where(school_id: current_user.school_id), :id, :name, {}, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :doc_type, "Document Type" %>
    <%= f.select :doc_type, TeacherDocument.doc_types.keys.map { |d| [d.humanize, d] } %>
  </div>
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>
  <div class="form-group">
    <%= f.label :file %>
    <%= f.file_field :file %>
  </div>
  <%= f.submit "Upload", class: "btn btn-primary" %>
<% end %>
