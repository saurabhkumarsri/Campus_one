<div class="page-header">
  <h1>Edit Announcement</h1>
  <%= link_to "Back", school_admin_announcements_path, class: "btn" %>
</div>

<%= form_with model: [:school_admin, @announcement], class: "form" do |f| %>
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :content %>
    <%= f.text_area :content, rows: 6, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :audience_type %>
    <%= f.select :audience_type, [["All", "all"], ["Students", "students"], ["Teachers", "teachers"], ["Parents", "parents"]], {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :priority %>
    <%= f.select :priority, [["Low", "low"], ["Medium", "medium"], ["High", "high"], ["Urgent", "urgent"]], {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :expires_at %>
    <%= f.datetime_local_field :expires_at, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.submit "Update Announcement", class: "btn btn-primary" %>
  </div>
<% end %>
