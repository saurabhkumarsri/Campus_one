<div class="page-header">
  <h1>Announcements</h1>
  <%= link_to "New Announcement", new_school_admin_announcement_path, class: "btn btn-primary" %>
</div>

<table class="data-table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Audience</th>
      <th>Priority</th>
      <th>Published At</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @announcements.each do |announcement| %>
      <tr>
        <td><%= announcement.title %></td>
        <td><%= announcement.audience_type %></td>
        <td>
          <span class="badge badge-<%= announcement.priority %>">
            <%= announcement.priority %>
          </span>
        </td>
        <td><%= l(announcement.published_at, format: :short) if announcement.published_at %></td>
        <td>
          <%= link_to "Edit", edit_school_admin_announcement_path(announcement), class: "btn btn-sm" %>
          <%= link_to "Delete", school_admin_announcement_path(announcement), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
