<div class="page-header">
  <h1>Teachers</h1>
  <%= link_to "+ New Teacher", new_school_admin_teacher_path, class: "btn btn-primary" %>
</div>

<% if @teachers.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Mobile</th>
        <th>Qualification</th>
        <th>Salary</th>
        <th>Status</th>
        <th class="actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @teachers.each do |teacher| %>
        <tr>
          <td><%= link_to teacher.name, school_admin_teacher_path(teacher) %></td>
          <td><%= teacher.email || "—" %></td>
          <td><%= teacher.mobile || "—" %></td>
          <td><%= teacher.qualification || "—" %></td>
          <td><%= number_to_currency(teacher.salary, unit: "₹") %></td>
          <td><%= badge_for(teacher.status) %></td>
          <td class="actions">
            <%= link_to "Edit", edit_school_admin_teacher_path(teacher), class: "btn btn-sm btn-secondary" %>
            <%= button_to "Delete", school_admin_teacher_path(teacher), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">👨‍🏫</div>
    <h3>No Teachers</h3>
    <p>Add teachers to your school.</p>
    <%= link_to "Create Teacher", new_school_admin_teacher_path, class: "btn btn-primary" %>
  </div>
<% end %>
