<div class="page-header">
  <h1>Live Classes</h1>
  <%= link_to "Schedule Live Class", new_school_admin_live_class_path, class: "btn btn-primary" %>
</div>

<table class="data-table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Class</th>
      <th>Subject</th>
      <th>Teacher</th>
      <th>Scheduled Time</th>
      <th>Platform</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @live_classes.each do |live_class| %>
      <tr>
        <td><%= live_class.title %></td>
        <td><%= live_class.classroom.name %></td>
        <td><%= live_class.subject.name %></td>
        <td><%= live_class.teacher.full_name %></td>
        <td><%= l(live_class.scheduled_at, format: :short) %></td>
        <td><%= live_class.platform %></td>
        <td>
          <span class="badge badge-<%= live_class.status %>">
            <%= live_class.status %>
          </span>
        </td>
        <td>
          <%= link_to "Edit", edit_school_admin_live_class_path(live_class), class: "btn btn-sm" %>
          <%= link_to "Attendance", attendance_school_admin_live_class_path(live_class), class: "btn btn-sm" %>
          <%= link_to "Delete", school_admin_live_class_path(live_class), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
