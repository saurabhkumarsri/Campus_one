<div class="page-header">
  <h1>Edit Live Class</h1>
  <%= link_to "Back", school_admin_live_classes_path, class: "btn" %>
</div>

<%= form_with model: [:school_admin, @live_class], class: "form" do |f| %>
  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :classroom_id, "Classroom" %>
    <%= f.collection_select :classroom_id, @classrooms, :id, :name, {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :subject_id, "Subject" %>
    <%= f.collection_select :subject_id, @subjects, :id, :name, {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :teacher_id, "Teacher" %>
    <%= f.collection_select :teacher_id, @teachers, :id, :full_name, {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :platform %>
    <%= f.select :platform, [["Zoom", "zoom"], ["Google Meet", "google_meet"], ["Microsoft Teams", "teams"], ["Other", "other"]], {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :meeting_url %>
    <%= f.url_field :meeting_url, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :meeting_id %>
    <%= f.text_field :meeting_id, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :passcode %>
    <%= f.text_field :passcode, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :scheduled_at %>
    <%= f.datetime_local_field :scheduled_at, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :duration, "Duration (minutes)" %>
    <%= f.number_field :duration, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :recording_url %>
    <%= f.url_field :recording_url, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.submit "Update Live Class", class: "btn btn-primary" %>
  </div>
<% end %>
