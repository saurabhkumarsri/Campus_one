<div class="page-header">
  <h1>Classes</h1>
  <%= link_to "+ New Class", new_school_admin_classroom_path, class: "btn btn-primary" %>
</div>

<% if @classrooms.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Status</th>
        <th class="actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @classrooms.each do |classroom| %>
        <tr>
          <td><%= classroom.name %></td>
          <td><%= badge_for(classroom.status) %></td>
          <td class="actions">
            <%= link_to "Edit", edit_school_admin_classroom_path(classroom), class: "btn btn-sm btn-secondary" %>
            <%= button_to "Delete", school_admin_classroom_path(classroom), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">🏫</div>
    <h3>No Classes</h3>
    <p>Create classes to organize your school.</p>
    <%= link_to "Create Class", new_school_admin_classroom_path, class: "btn btn-primary" %>
  </div>
<% end %>
