<div class="page-header">
  <h1>AI Homework Generator</h1>
</div>

<div class="card">
  <%= form_with url: school_admin_ai_generate_homework_path, class: "form-grid" do |f| %>
    <div class="form-group">
      <%= f.label :classroom_id, "Classroom" %>
      <%= f.collection_select :classroom_id, @classrooms || [], :id, :name, include_blank: "Select Classroom" %>
    </div>

    <div class="form-group">
      <%= f.label :subject_id, "Subject" %>
      <%= f.collection_select :subject_id, @subjects || [], :id, :name, include_blank: "Select Subject" %>
    </div>

    <div class="form-group">
      <%= f.label :topic, "Topic" %>
      <%= f.text_field :topic, placeholder: "e.g. Cell Structure, Pronouns" %>
    </div>

    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.submit "Generate Homework", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<% if @generated_homework %>
  <div class="card" style="margin-top: 24px;">
    <div class="page-header" style="margin-bottom: 16px;">
      <h2>Generated Homework</h2>
      <%= link_to "Download PDF", "#", class: "btn btn-sm btn-secondary" %>
    </div>

    <div style="background: var(--bg); padding: 20px; border-radius: var(--radius); border: 1px solid var(--border);">
      <h3 style="margin: 0 0 8px;"><%= @generated_homework.subject&.name || "Subject" %> — <%= @generated_homework.topic %></h3>
      <p style="color: var(--text-muted); font-size: 14px; margin: 0 0 16px;">
        Class: <%= @generated_homework.classroom&.name %> | Generated on <%= @generated_homework.created_at&.strftime("%d %b %Y") %>
      </p>
      <hr style="border: none; border-top: 1px solid var(--border); margin: 16px 0;">
      <div style="font-size: 15px; line-height: 1.7; white-space: pre-wrap;">
        <%= @generated_homework.content %>
      </div>
    </div>
  </div>
<% end %>
