<div class="page-header">
  <h1>Student Attendance</h1>
  <%= link_to "Monthly Report", monthly_report_school_admin_student_attendances_path, class: "btn btn-secondary" %>
</div>

<%= form_with url: school_admin_student_attendances_path, method: :get, class: "filter-bar" do |f| %>
  <div class="form-group">
    <%= f.label :classroom_id, "Class" %>
    <%= f.collection_select :classroom_id, @classrooms, :id, :name, selected: @classroom&.id %>
  </div>
  <div class="form-group">
    <%= f.label :date, "Date" %>
    <%= f.date_field :date, value: @date %>
  </div>
  <div class="form-group">
    <%= f.submit "Load", class: "btn btn-secondary" %>
  </div>
<% end %>

<% if @classroom && @students.any? %>
  <%= form_with url: school_admin_student_attendances_path, method: :post do |f| %>
    <%= hidden_field_tag :classroom_id, @classroom.id %>
    <%= hidden_field_tag :date, @date %>

    <div class="attendance-grid">
      <% @students.each do |student| %>
        <% existing = @existing&&@existing[student.id] %>
        <div class="attendance-card">
          <div class="student-name"><%= student.name %></div>
          <div class="student-roll"><%= student.roll_no || "—" %></div>
          <div class="attendance-status">
            <%= radio_button_tag "attendances[#{student.id}][status]", "present", (existing&& existing.status == "present") || true, id: "student_#{student.id}_present" %>
            <%= label_tag "student_#{student.id}_present", "P", class: "present" %>

            <%= radio_button_tag "attendances[#{student.id}][status]", "absent", existing&& existing.status == "absent", id: "student_#{student.id}_absent" %>
            <%= label_tag "student_#{student.id}_absent", "A", class: "absent" %>

            <%= radio_button_tag "attendances[#{student.id}][status]", "leave", existing&& existing.status == "leave", id: "student_#{student.id}_leave" %>
            <%= label_tag "student_#{student.id}_leave", "L", class: "leave" %>
          </div>
        </div>
      <% end %>
    </div>

    <div style="margin-top: 20px;">
      <%= f.submit "Save Attendance", class: "btn btn-primary" %>
    </div>
  <% end %>
<% elsif @classroom %>
  <div class="empty-state">
    <div class="empty-state-icon">✅</div>
    <h3>No Students</h3>
    <p>There are no students in this class yet.</p>
  </div>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">✅</div>
    <h3>No Classes</h3>
    <p>Create classes first to mark attendance.</p>
  </div>
<% end %>
