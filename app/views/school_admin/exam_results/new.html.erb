<div class="page-header">
  <h1>New Result</h1>
  <%= link_to "Back", school_admin_exam_exam_results_path(@exam), class: "btn btn-secondary" %>
</div>

<%= form_with model: [:school_admin, @exam, @result], class: "form-grid" do |f| %>
  <% if @result.errors.any? %>
    <div class="flash flash-alert">
      <ul>
        <% @result.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :student_id, "Student" %>
    <%= f.collection_select :student_id, @students, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :marks_obtained %>
    <%= f.number_field :marks_obtained, step: 0.01, min: 0 %>
  </div>

  <div class="form-group">
    <%= f.label :remarks %>
    <%= f.text_area :remarks, rows: 3 %>
  </div>

  <div class="form-group">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", school_admin_exam_exam_results_path(@exam), class: "btn btn-secondary" %>
  </div>
<% end %>
