<div class="page-header">
  <h1>New Subject Assignment</h1>
</div>

<%= form_with model: [:school_admin, @assignment], url: school_admin_subject_assignments_path, class: "form-grid" do |f| %>
  <% if @assignment.errors.any? %>
    <div class="flash flash-alert">
      <ul>
        <% @assignment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :classroom_id, "Class" %>
    <%= f.collection_select :classroom_id, @classrooms, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :subject_id, "Subject" %>
    <%= f.collection_select :subject_id, @subjects, :id, :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :teacher_id, "Teacher" %>
    <%= f.collection_select :teacher_id, @teachers, :id, :name, include_blank: "Select Teacher" %>
  </div>

  <div class="form-group">
    <%= f.submit "Assign Subject", class: "btn btn-primary" %>
    <%= link_to "Cancel", school_admin_subject_assignments_path, class: "btn btn-secondary" %>
  </div>
<% end %>
