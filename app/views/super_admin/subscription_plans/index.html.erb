<div class="page-header">
  <h1>Subscription Plans</h1>
  <%= link_to "+ New Plan", new_super_admin_subscription_plan_path, class: "btn btn-primary" %>
</div>

<% if @plans.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Duration</th>
        <th>Status</th>
        <th class="actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @plans.each do |plan| %>
        <tr>
          <td><%= plan.name %></td>
          <td><%= number_to_currency(plan.price, unit: "₹") %></td>
          <td><%= plan.duration_months %> months</td>
          <td><%= badge_for(plan.status) %></td>
          <td class="actions">
            <%= link_to "Edit", edit_super_admin_subscription_plan_path(plan), class: "btn btn-sm btn-secondary" %>
            <%= button_to "Delete", super_admin_subscription_plan_path(plan), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">💳</div>
    <h3>No Plans</h3>
    <p>Create subscription plans for schools.</p>
    <%= link_to "Create Plan", new_super_admin_subscription_plan_path, class: "btn btn-primary" %>
  </div>
<% end %>
