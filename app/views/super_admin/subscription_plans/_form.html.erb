<%= form_with model: [:super_admin, @plan], class: "form-grid" do |f| %>
  <% if @plan.errors.any? %>
    <div class="flash flash-alert">
      <ul>
        <% @plan.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :price %>
    <%= f.number_field :price, step: 0.01, min: 0, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :duration_months, "Duration (months)" %>
    <%= f.number_field :duration_months, min: 1, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :status %>
    <%= f.select :status, status_options %>
  </div>

  <div class="form-group">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", super_admin_subscription_plans_path, class: "btn btn-secondary" %>
  </div>
<% end %>
