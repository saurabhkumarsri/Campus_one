<div class="page-header">
  <h1>Super Admin Dashboard</h1>
</div>

<div class="cards-grid">
  <div class="card">
    <div class="card-stat">
      <div class="card-stat-icon">🏫</div>
      <div class="card-stat-info">
        <h3><%= @total_schools %></h3>
        <p>Total Schools</p>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-stat">
      <div class="card-stat-icon">✅</div>
      <div class="card-stat-info">
        <h3><%= @active_schools %></h3>
        <p>Active Schools</p>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-stat">
      <div class="card-stat-icon">⚠️</div>
      <div class="card-stat-info">
        <h3><%= @expiring_schools %></h3>
        <p>Expiring Soon</p>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-stat">
      <div class="card-stat-icon">👤</div>
      <div class="card-stat-info">
        <h3><%= @total_school_admins %></h3>
        <p>School Admins</p>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <h3>Recent Schools</h3>
  <% if @recent_schools.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Status</th>
          <th>Subscription Expiry</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_schools.each do |school| %>
          <tr>
            <td><%= link_to school.name, super_admin_school_path(school) %></td>
            <td><%= school.email %></td>
            <td><%= badge_for(school.status) %></td>
            <td><%= school.subscription_expiry&.strftime("%d %b %Y") || "N/A" %></td>
            <td><%= school.created_at.strftime("%d %b %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state">No schools yet.</p>
  <% end %>
</div>
