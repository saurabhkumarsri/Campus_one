<div class="page-header">
  <h1>Reports</h1>
</div>

<div class="report-grid">
  <div class="report-card">
    <h3>Schools by Status</h3>
    <% if @schools_by_status.any? %>
      <table class="data-table">
        <thead>
          <tr><th>Status</th><th>Count</th></tr>
        </thead>
        <tbody>
          <% @schools_by_status.each do |status, count| %>
            <tr>
              <td><%= badge_for(status) %></td>
              <td><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state">No data available.</p>
    <% end %>
  </div>

  <div class="report-card">
    <h3>Schools by Month</h3>
    <% if @schools_by_month.any? %>
      <table class="data-table">
        <thead>
          <tr><th>Month</th><th>Count</th></tr>
        </thead>
        <tbody>
          <% @schools_by_month.each do |month, count| %>
            <tr>
              <td><%= month %></td>
              <td><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state">No data available.</p>
    <% end %>
  </div>

  <div class="report-card">
    <h3>Expiring Subscriptions (Next 30 Days)</h3>
    <% if @expiring_subscriptions.any? %>
      <table class="data-table">
        <thead>
          <tr>
            <th>School</th>
            <th>Expiry Date</th>
          </tr>
        </thead>
        <tbody>
          <% @expiring_subscriptions.each do |school| %>
            <tr>
              <td><%= school.name %></td>
              <td><%= school.subscription_expiry.strftime("%d %b %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state">No subscriptions expiring soon.</p>
    <% end %>
  </div>
</div>
