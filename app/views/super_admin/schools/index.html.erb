<div class="page-header">
  <h1>Schools</h1>
  <%= link_to "+ New School", new_super_admin_school_path, class: "btn btn-primary" %>
</div>

<% if @schools.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Status</th>
        <th>Subscription Expiry</th>
        <th class="actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @schools.each do |school| %>
        <tr>
          <td><%= school.name %></td>
          <td><%= school.email %></td>
          <td><%= school.phone %></td>
          <td><%= badge_for(school.status) %></td>
          <td><%= school.subscription_expiry&.strftime("%d %b %Y") || "N/A" %></td>
          <td class="actions">
            <%= link_to "View", super_admin_school_path(school), class: "btn btn-sm btn-secondary" %>
            <%= link_to "Edit", edit_super_admin_school_path(school), class: "btn btn-sm btn-secondary" %>
            <%= button_to "Delete", super_admin_school_path(school), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">🏫</div>
    <h3>No Schools</h3>
    <p>Get started by creating your first school.</p>
    <%= link_to "Create School", new_super_admin_school_path, class: "btn btn-primary" %>
  </div>
<% end %>
