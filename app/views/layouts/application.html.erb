<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Campus One" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Campus One">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if current_user %>
      <div class="app-layout">
        <aside class="sidebar">
          <div class="sidebar-brand">
            <span class="brand-icon">📚</span>
            <span class="brand-text">Campus One</span>
          </div>

          <nav class="sidebar-nav">
            <% if current_user.super_admin? %>
              <%= render "layouts/super_admin_nav" %>
            <% elsif current_user.school_admin? %>
              <%= render "layouts/school_admin_nav" %>
            <% end %>
          </nav>

          <div class="sidebar-footer">
            <div class="user-info">
              <span class="user-name"><%= current_user.name %></span>
              <span class="user-role"><%= current_user.role.humanize %></span>
            </div>
            <%= button_to logout_path, method: :delete, class: "btn-logout" do %>
              <span>🚪</span> Logout
            <% end %>
          </div>
        </aside>

        <main class="main-content">
          <%= render "layouts/flash" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <%= render "layouts/flash" %>
      <%= yield %>
    <% end %>
  </body>
</html>
