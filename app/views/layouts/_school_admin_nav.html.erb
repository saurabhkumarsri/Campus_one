  <li class="nav-item">
    <%= link_to school_admin_fee_structures_path, class: "nav-link #{controller_name == 'fee_structures' ? 'active' : ''}" do %>
      <span>💰</span> Fee Structure
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to school_admin_fee_collections_path, class: "nav-link #{controller_name == 'fee_collections' ? 'active' : ''}" do %>
      <span>💵</span> Fee Collection
    <% end %>
