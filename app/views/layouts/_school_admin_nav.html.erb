  <li class="nav-item">
    <%= link_to school_admin_students_path, class: "nav-link #{controller_name == 'students' ? 'active' : ''}" do %>
      <span>👨‍🎓</span> Students
    <% end %>
  </li>

  <li class="nav-section">Operations</li>
  <li class="nav-item">
    <%= link_to school_admin_student_attendances_path, class: "nav-link #{controller_name == 'student_attendances' ? 'active' : ''}" do %>
