<ul class="nav-list">
  <li class="nav-item">
    <%= link_to school_admin_root_path, class: "nav-link #{current_page?(school_admin_root_path) ? 'active' : ''}" do %>
      <span>📊</span> Dashboard
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to school_admin_subscriptions_path, class: "nav-link #{controller_name == 'subscriptions' ? 'active' : ''}" do %>
      <span>💳</span> Subscription
      <% if current_user.school&.subscription_expired? %>
        <span class="badge badge-danger" style="margin-left: auto;">Expired</span>
      <% elsif current_user.school&.subscription_days_remaining.to_i <= 7 %>
        <span class="badge badge-warning" style="margin-left: auto;"><%= current_user.school.subscription_days_remaining %>d</span>
      <% end %>
    <% end %>
  </li>

  <li class="nav-section">Academic</li>
  <li class="nav-item">
    <%= link_to school_admin_classrooms_path, class: "nav-link #{controller_name == 'classrooms' ? 'active' : ''}" do %>
      <span>🏫</span> Classes
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to school_admin_sections_path, class: "nav-link #{controller_name == 'sections' ? 'active' : ''}" do %>
      <span>📐</span> Sections
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to school_admin_subjects_path, class: "nav-link #{controller_name == 'subjects' ? 'active' : ''}" do %>
      <span>📚</span> Subjects
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to school_admin_subject_assignments_path, class: "nav-link #{controller_name == 'subject_assignments' ? 'active' : ''}" do %>
      <span>📝</span> Subject Assignments
    <% end %>
  </li>

  <li class="nav-section">People</li>
  <li class="nav-item">
    <%= link_to school_admin_teachers_path, class: "nav-link #{controller_name == 'teachers' ? 'active' : ''}" do %>
      <span>👨‍🏫</span> Teachers
    <% end %>
