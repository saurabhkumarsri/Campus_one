<div class="login-container">
  <div class="login-card">
    <div class="login-back">
      <%= link_to root_path, class: "login-back-link" do %>
        <span>←</span> Back to Home
      <% end %>
    </div>
    <div class="login-header">
      <h1>Campus One</h1>
      <p>School Management System</p>
    </div>

    <%= form_with url: login_path, class: "login-form" do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, required: true, autofocus: true, placeholder: "Enter your email" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, required: true, placeholder: "Enter your password" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Sign In", class: "btn btn-primary btn-block" %>
      </div>
    <% end %>

    <div class="login-footer-links">
      <%= link_to "🛡️ Super Admin Login", super_admin_login_path, class: "sa-login-link" %>
    </div>
  </div>
</div>
