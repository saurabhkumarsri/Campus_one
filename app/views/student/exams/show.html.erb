<div class="page-header">
  <h1><%= @exam&.name %></h1>
</div>

<div class="cards-grid">
  <div class="card">
    <h2>Exam Details</h2>
    <div class="form-group">
      <label>Subject</label>
      <p><%= @exam&.subject&.name %></p>
    </div>
    <div class="form-group">
      <label>Date</label>
      <p><%= @exam&.date&.strftime("%b %d, %Y") %></p>
    </div>
    <div class="form-group">
      <label>Time</label>
      <p><%= @exam&.start_time&.strftime("%H:%M") %> - <%= @exam&.end_time&.strftime("%H:%M") %></p>
    </div>
    <div class="form-group">
      <label>Total Marks</label>
      <p><%= @exam&.total_marks %></p>
    </div>
  </div>

  <% if @exam&.result_published? %>
    <div class="card">
      <h2>Your Result</h2>
      <div class="form-group">
        <label>Marks Obtained</label>
        <p><%= @result&.marks_obtained %> / <%= @exam.total_marks %></p>
      </div>
      <div class="form-group">
        <label>Grade</label>
        <p><span class="badge"><%= @result&.grade %></span></p>
      </div>
      <div class="form-group">
        <label>Remarks</label>
        <p><%= @result&.remarks || "-" %></p>
      </div>
    </div>
  <% end %>
</div>
