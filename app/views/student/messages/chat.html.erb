<div class="page-header">
  <h1>Chat with <%= @other_user&.name %></h1>
</div>

<div class="card chat-card">
  <div class="chat-messages">
    <% (@messages || []).each do |message| %>
      <div class="message <%= message.sender_id == current_user.id ? 'message-sent' : 'message-received' %>">
        <div class="message-content">
          <p><%= message.body %></p>
          <span class="message-time"><%= message.created_at&.strftime("%H:%M") %></span>
        </div>
      </div>
    <% end %>
  </div>

  <div class="chat-input">
    <%= form_with url: student_messages_path, local: true do |f| %>
      <%= f.hidden_field :conversation_id, value: @conversation&.id %>
      <%= f.hidden_field :receiver_id, value: @other_user&.id %>
      <div class="form-group">
        <%= f.text_area :body, placeholder: "Type your message...", rows: 2 %>
      </div>
      <%= f.submit "Send", class: "btn" %>
    <% end %>
  </div>
</div>
